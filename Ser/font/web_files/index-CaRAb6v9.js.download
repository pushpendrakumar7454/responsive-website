der group text-white! shrink-0 flex items-center max-md:text-xl p-3 px-6 rounded-lg border-white/40",children:n.jsx(ka,{parentHover:!0,children:n.jsx(Lu,{})})}),n.jsxs(g0,{color:"orange",to:"/checkout?courseId="+p.courseId+"&batchId="+((v=p.batches)==null?void 0:v.batchId),wrapperClassName:"max-md:w-full rounded-lg!",className:"max-md:w-full max-md:rounded rounded-lg!",children:["Enroll Now ",n.jsx("span",{children:"→"})]})]})]})]}):n.jsx(_0,{footer:!1,children:n.jsxs(N2,{className:"flex h-[50vh] w-full flex-col items-center justify-center gap-4",children:[n.jsx("div",{className:"text-xl",children:"Course not found"}),n.jsx(A0,{to:"/courses",className:"btn btn-primary",children:"Back to Courses"})]})})},l3=[{id:1,title:"Electronic Communication",content:n.jsx("div",{className:"md:space-y-2 -mt-3",children:n.jsxs("ul",{className:"list-disc space-y-2 marker:font-semibold md:ml-10 ml-2",children:[n.jsx("li",{children:"When you voluntarily send us electronic mail, we will keep a record of this information so that we can respond to you. We only collect information from you when you register on our site or fill out a form. Also, when filling out a form on our site, you may be asked to enter your: name, e-mail address or phone number. You may, however, visit our site anonymously. In case you have submitted your personal information and contact details, we reserve the rights to Call, SMS, Email or WhatsApp about our products and offers, even if your number has DND activated on it."}),n.jsxs("li",{children:["At the point when you visit our site, we might gather your personal identifiable information that can be used to contact or identify you. Information may include, but is not limited to:",n.jsxs("ul",{className:"list-[lower-roman] ml-5 md:ml-10",children:[n.jsx("li",{children:"Your name"}),n.jsx("li",{children:"Your email"}),n.jsx("li",{children:"Your contact information"}),n.jsx("li",{children:"Your account details i.e. courses you opted for"}),n.jsx("li",{children:"Data through promotion and surveys conducted through us"}),n.jsx("li",{children:"Data regarding any support concerns that you may have"}),n.jsx("li",{children:"Parts of our Services you use etc"})]})]}),n.jsxs("li",{children:['We may also collect Information that your browser sends whenever you visit our Site ("Log Data"). This Log Data may include information such as:',n.jsxs("ul",{className:"list-[lower-roman] ml-5 md:ml-10",children:[n.jsx("li",{children:"your IP address"}),n.jsx("li",{children:"browser type"}),n.jsx("li",{children:"device type"}),n.jsx("li",{children:"browser version"}),n.jsx("li",{children:"the pages of our Site that you visit"}),n.jsx("li",{children:"the time and date of your visit"}),n.jsx("li",{children:"the time spent on those pages and other statistics and approximate geographic location,including"}),n.jsx("li",{children:"information like country, city, and geographic coordinates, calculated based on your IP address."})]})]}),n.jsx("li",{children:"In order to receive payments from you, we may also collect (either directly or with the support of our payments partners) certain financial Information as may be required."}),n.jsx("li",{children:"In addition, we may use third party services such as cookies, google analytics, advertisements that collect, monitor and analyze this type of Information in order to increase the performance of our Service's. Use of such Information by these third party services shall be governed by their individual privacy policies. We encourage you to understand these policies as well."}),n.jsx("li",{children:"We use cookies to store, access and analyze the Information on the device that you use to access our Services, to personalize your experience, and to facilitate you to log into the Services, and to recognize when you return to the Services."}),n.jsx("li",{children:"You may opt out or refuse your browser from accessing/ storing the cookies or indicating when a cookie being sent. However, it may be noted that some portions of our service may not be accessible to you if you do not accept cookies"})]})})},{id:2,title:"Use Of Your Personal Information",content:n.jsx("div",{className:"space-y-2",children:n.jsxs("ul",{className:"list-disc md:ml-10 ml-2",children:[n.jsx("li",{children:" We use your information for purposes such as:"}),n.jsxs("ul",{className:"list-[lower-roman] ml-5 md:ml-10",children:[n.jsx("li",{children:"Providing our services"}),n.jsx("li",{children:"Improving our services and developing new products, services, and features"}),n.jsx("li",{children:"Analyzing trends, traffic, and tracking purchases"}),n.jsx("li",{children:"Learning more about our users by linking user data with additional data from third-party providers or analyzing it with analytics services"}),n.jsx("li",{children:"Communicating with you"}),n.jsx("li",{children:"Analyzing and troubleshooting issues you may experience with our services"}),n.jsx("li",{children:"Protecting against fraud and abuse"}),n.jsx("li",{children:"Improving and updating our services based on your feedback"})]})]})})},{id:3,title:"Information Sharing",content:n.jsxs("div",{className:"space-y-4",children:[n.jsxs("ul",{className:"list-disc md:ml-10 ml-2",children:[n.jsx("li",{children:"We may share certain information about you in the following circumstances:"}),n.jsxs("ul",{className:"list-[lower-roman] ml-5 md:ml-10",children:[n.jsx("li",{children:"With third parties such as instructors, other students, companies assisting us with promotions and surveys, and advertising partners"}),n.jsx("li",{children:"For security purposes, legal compliance, or as part of a corporate restructuring"}),n.jsx("li",{children:"In other cases, if the information is aggregated or de-identified, or if we have your consent"})]}),n.jsxs("li",{children:["Your information may be shared with third parties under the following conditions or as otherwise described in this Privacy Policy:",n.jsxs("ul",{className:"list-[lower-roman] ml-5 md:ml-10 ",children:[n.jsx("li",{children:"With Instructors"}),n.jsx("li",{children:"We may share information such as your country of login, language, device settings, the site that referred you, and your activity on the platform. We may also share your email address and contact details with instructors or teaching assistants."}),n.jsx("li",{children:"With Other Students and Instructors"}),n.jsx("li",{children:"Depending on your account settings, your shared content and profile information may be publicly visible to other students and instructors."}),n.jsx("li",{children:"With Service Providers, Contractors, and Agents"}),n.jsx("li",{children:"We may share your information with third-party service providers who perform services on our behalf, such as payment processing, data analysis, marketing and advertising (including retargeted advertising), email services, hosting, and customer support."})]})]})]}),n.jsx("p",{className:"text-lg font-bold",children:"Additional Information Sharing"}),n.jsxs("ul",{className:"list-disc ml-5 md:ml-10  ",children:[n.jsx("li",{children:"Service providers who assist us may access your information only as necessary to perform services on our behalf and are required to use it solely in accordance with our instructions."}),n.jsx("li",{children:"Promotions and Surveys"}),n.jsx("li",{children:"We may share your information as necessary to administer, market, or sponsor promotions and surveys that you choose to participate in. This may include sharing data as required by applicable law (for example, to provide a winners list or complete required filings) or in accordance with the rules governing the promotion or survey."}),n.jsx("li",{children:"Security and Legal Compliance"}),n.jsx("li",{children:"We may disclose your information to third parties if we have a good faith belief that such disclosure is:"}),n.jsxs("ol",{className:"list-[lower-roman] ml-5 md:ml-10 ",children:[n.jsx("li",{children:"Permitted or required by law, or in response to a judicial, governmental, or legal request, order, or proceeding"}),n.jsx("li",{children:"Reasonably necessary to enforce our Terms of Use, Privacy Policy, or other legal agreements"}),n.jsx("li",{children:"Necessary to detect, prevent, or address fraud, abuse, misuse, potential violations of law, or security or technical issues"}),n.jsx("li",{children:"Necessary to protect against imminent harm to the rights, property, or safety of the Company, our users, employees, the public, or our services"})]})]}),n.jsx("p",{className:"font-bold text-lg my-4",children:"Additional Disclosures"}),n.jsxs("ul",{className:"list-disc ml-5 md:ml-10 ",children:[n.jsx("li",{children:"We may also disclose information about you in the following situations:"}),n.jsxs("ul",{className:"list-[lower-roman] ml-5 md:ml-10",children:[n.jsx("li",{children:"With Auditors and Legal Advisors"}),n.jsx("li",{children:"We may share your information with our auditors and legal advisors to assess our obligations and rights under this Privacy Policy."}),n.jsx("li",{children:"Business Transfers"}),n.jsx("li",{children:"In the event of a business transaction such as a merger, acquisition, corporate restructuring, divestiture, dissolution, or bankruptcy, or the sale of all or part of our assets, your information may be shared, disclosed, or transferred to the successor organization. This may occur during the transaction process or in preparation for such a transition (including due diligence)."}),n.jsx("li",{children:"Within Our Corporate Group"}),n.jsx("li",{children:"We may share your information within our group of companies that are under common ownership or control to support and improve the delivery of our services."})]})]})]})},{id:4,title:"Information Review",content:n.jsx("div",{className:"space-y-6",children:n.jsxs("ul",{className:"list-disc  md:ml-10 ml-2",children:[n.jsx("li",{children:"We request you to review the Information you provide to us from time to time to ensure that any Information or Sensitive Personal Information (as defined below) is not inaccurate or deficient."}),n.jsx("li",{children:"We are not responsible for the authenticity of any Information or Sensitive Personal information supplied by you. Sensitive Personal Information” shall mean passwords and any other information that is classified as sensitive under Section 3 of the Information Technology (Reasonable Security Practices and Procedures and Sensitive Personal Data or Information) Rules, 2011 (“Rules”)."}),n.jsx("li",{children:"We shall address any discrepancies and your grievances with respect to Information or Sensitive Personal Information within 30 days of identification of such discrepancies."})]})})},{id:5,title:"Information Retention",content:n.jsx("div",{className:"space-y-6",children:n.jsxs("ul",{className:"list-disc md:ml-10 ml-2",children:[n.jsx("li",{children:"We do not retain your Sensitive Personal Information for longer than is required for the purposes for which the information may be lawfully used."}),n.jsx("li",{children:"For any other content, we will entertain your request for deletion, however, there is a strong possibility that copies of any public content will be retained indefinitely in our systems, including in cached and archived pages of the Platform, or if other users have copied or saved that information."}),n.jsx("li",{children:"In addition, due to the nature of the internet, copies of your content, including content that you have removed or deleted from your account, may also exist elsewhere on the Internet and be retained indefinitely. We may also retain Information where relevant for internal processing, analytical reasons, fraud monitoring, and in some cases on an anonymised/ de-identified basis."})]})})},{id:6,title:"Your Rights",content:n.jsx("div",{className:"space-y-6",children:n.jsxs("ul",{className:"list-disc md:ml-10 ml-2",children:[n.jsx("li",{children:"You have the right around the use of your Information, including the option to opt out of promotional emails, cookies, and collection of your data by certain advertisement services."}),n.jsx("li",{children:"You can update or terminate your Account from within our Services, and can also contact us for individual rights requests about your Information. You have a right to ask us to review, correct and amend the information we collect about you at any point in time."}),n.jsx("li",{children:"In addition, you also have the right to revoke your consent to the collection of your information going forward. However, please note that revoking your consent may negatively affect your use of the Platform. For instance, we need access to your Account details so that you can access Services on the Platform, which functionality will not be available to you if you do not provide us such access."}),n.jsxs("li",{children:["You may also ask us not to process your personal data for marketing purposes. You can exercise any of these rights at any time by contacting us at"," ",n.jsxs("a",{href:"mailto:hello@sheryians.com",className:"text-white font-semibold cursor-pointer hover:text-[#E8602E] transition-colors duration-300",children:[n.jsx("span",{className:"underline",children:"hello@sheryians.com"})," "]}),"However, we require a reasonable period of 30 (thirty) days to comply with any of your requests."]})]})})},{id:7,title:"Third Party Links",content:n.jsx("div",{className:"space-y-6",children:n.jsxs("ul",{className:"list-disc md:ml-10 ml-2",children:[n.jsx("li",{children:"The Platform may, from time to time, contain links to and from the websites of our partner networks, advertisers, Affiliates and/or any other websites or mobile applications. If you follow a link to any of these websites, please note that these websites have their own privacy policies and that we do not accept any responsibility or liability for these policies."}),n.jsx("li",{children:"Please check these policies before you submit any personal data to these websites or mobile applications."})]})})},{id:8,title:"Changes To Privacy Policy",content:n.jsx("div",{className:"space-y-6",children:n.jsx("ul",{className:"list-disc  md:ml-10 ml-2",children:n.jsx("li",{children:"The Company may periodically update this Privacy Policy. We will post the updated Privacy Policy at this link. Your continued use of the Services constitutes your acceptance of the updated Privacy Policy."})})})},{id:9,title:"Disclaimer",content:n.jsx("div",{className:"space-y-6",children:n.jsx("ul",{className:"list-disc  md:ml-10 ml-2",children:n.jsx("li",{children:"We follow best procedures and take security measures to protect your Information and try to prevent unauthorized access. However, we cannot guarantee the security of your Information transmitted to the Platform. You agree that any transmission on the Platform is at your own risk."})})})},{id:10,title:"Data Security",content:n.jsx("div",{className:"space-y-6",children:n.jsxs("ul",{className:"list-disc  md:ml-10 ml-2",children:[n.jsx("li",{children:"The information that you provide, subject to disclosure in accordance with this policy, shall be maintained in a safe and secure manner. Your information shall be protected, to a commercially reasonable extent, against unauthorized access, use, or disclosure. Our databases and information are stored on secure servers with appropriate firewalls."}),n.jsx("li",{children:"As a user of the Company Systems, you have the responsibility to ensure data security. You must not disclose to any person the authentication parameters that are assigned to you including Your username or password for your use of the Company Systems. You acknowledge that you will be solely responsible for all acts committed by use of your username /other authentication parameters. International payments and user data management We process payments for your online courses through a secure payment gateway. In order to process payments, payment gateway providers may collect and store payment information like credit card information."}),n.jsx("li",{children:"We go to fitting lengths to guarantee the security of your own information. Your personal information is safeguarded from unauthorized access, disclosure, alterations, or destruction by utilizing industry-standard encryption technology."}),n.jsx("li",{children:"We claim all authority to change this protection strategy whenever. Any progressions to our protection strategy will be posted on this page."})]})})},{id:11,title:"Communications From Us",content:n.jsx("div",{className:"space-y-6",children:n.jsxs("ul",{className:"list-disc  md:ml-10 ml-2",children:[n.jsx("li",{children:"We may from time to time send you service-related announcements when we consider it necessary to do so (such as when we temporarily suspend the Platform for maintenance, or security, privacy, or administrative-related communications)."}),n.jsx("li",{children:"We send these to you via SMS, email, push notifications and any other communication channel. You may not opt-out of these service-related announcements, which are not promotional in nature and used solely to protect your account and keep you informed of important changes to the Platform."})]})})},{id:12,title:"Grievance Officer",content:n.jsx("div",{className:"space-y-6",children:n.jsxs("ul",{className:"list-disc  md:ml-10 ml-2",children:[n.jsx("li",{children:"The Company has a Grievance Officer to address your concerns regarding data safety, privacy, discrepancies and the usage of Platform. We will resolve the issues raised by you within 30 (thirty) days from receiving them."}),n.jsxs("li",{children:["You may contact the Grievance Officer at: Address: Mr. Harsh Patel, Sheryians Coding School, 23B Indrapuri C Sector, Bhopal Madhya Pradesh 462022, Office Hours: 10:00 A.M. to 1:00 P.M., Monday to Friday. Email:"," ",n.jsxs("a",{href:"mailto:hello@sheryians.com",className:"text-white font-semibold cursor-pointer hover:text-[#E8602E] transition-colors duration-300",children:[n.jsx("span",{className:"underline",children:"hello@sheryians.com"})," "]})]})]})})},{id:13,title:"Use Of Infringed Material In The Course",content:n.jsx("div",{className:"space-y-6",children:n.jsx("ul",{className:"list-disc  md:ml-10 ml-2",children:n.jsx("li",{children:"We aim to ensure that an Instructor or any third party anyone else’s work in your course material, such material should be cited appropriately. Instructors and third parties should obtain licenses/ authorisation for Course content, if required."})})})},{id:14,title:"How To Report Infringement",content:n.jsxs("div",{className:"space-y-6",children:[n.jsx("ul",{className:"list-disc  md:ml-10 ml-2",children:n.jsxs("li",{children:["If you wish to report any Content/Course that you believe violates your copyright or trademark, please contact us at:"," ",n.jsxs("a",{href:"mailto:hello@sheryians.com",className:"text-white font-semibold cursor-pointer hover:text-[#E8602E] transition-colors duration-300",children:[n.jsx("span",{className:"underline",children:"hello@sheryians.com"})," "]})]})}),n.jsx("p",{className:"text-xl font-semibold ",children:"Before emailing, please note the following:"}),n.jsxs("ul",{className:"list-disc  ml-5 md:ml-10",children:[n.jsx("li",{children:"We cannot process any claim that is not submitted by the owner of the copyright/trademark or their designated agent. Therefore, we will ask you to provide your signature to confirm that you are the copyright/trademark owner or have the authority to represent the owner."}),n.jsxs("li",{children:["Your copyright/trademark claim should include the following information:",n.jsxs("ul",{className:"list-[lower-roman] ml-10",children:[n.jsx("li",{children:"Your contact information, including your full legal name, email address, physical address, and (optional) telephone number"}),n.jsx("li",{children:"A sufficiently representative list of the original material (such as a URL where the material is located)"})]})]})]}),n.jsxs("ul",{className:"list-disc  ml-5 md:ml-10",children:[n.jsx("li",{children:"You add a declaration under penalty of perjury stating:"}),n.jsx("ul",{children:n.jsx("li",{children:"“I declare that the information in this complaint is accurate and that I am the copyright/trademark owner or am authorized to act on the owner's behalf, and I have a good faith belief that the use of the material in the manner complained of is not authorized by the owner, its agent, or the law.”"})}),n.jsx("li",{children:"Knowingly submitting a false or misleading claim of infringement is illegal, and you may be held liable and required to pay damages as a result."}),n.jsx("li",{children:"There are types of content that are not protected by copyright, such as short phrases (like business names, book titles, and slogans), intangible concepts (like processes, ideas, and recipes), or facts."}),n.jsx("li",{children:"On receipt of the form, if we are satisfied from the details provided in the complaint that the copy of the work is an infringed copy, we shall endeavor to take down any infringing content from our platform."})]})]})}],s3=[{id:1,title:"ACCOUNTS",content:n.jsxs("div",{className:"space-y-4 text-gray-700 leading-relaxed",children:[n.jsxs("p",{children:["You need an ",n.jsx("b",{className:"font-bold text-underline ",children:"account"})," for most activities on the Site. By signing on the platform and creating an account you confirm that you are the age of majority and competent / of entering into a contract in your country. If you are not of age, then we request you to take assistance from a parent or guardian to create an account and help you enroll and pay for courses that are relevant for you."]}),n.jsx("p",{children:"You shall use the Account to enroll for Services that may be provided on the specific terms and conditions as may be applicable. You agree and undertake to provide true, correct, accurate and complete information, including your:"}),n.jsxs("ul",{className:"list-disc md:ml-10 space-y-2",children:[n.jsx("li",{children:"Name;"}),n.jsx("li",{children:"Email;"}),n.jsx("li",{children:"Phone number (if required)"})]}),n.jsx("p",{children:"In addition, from time to time, based on the Services availed by you, we may request for additional information such as your address, financial information, and educational qualifications."}),n.jsxs("p",{children:["Please ",n.jsx("b",{className:"font-bold",children:"do not share"})," your Account details, personal information with others. Any harm or loss suffered on account of an unauthorized disclosure or access of your Account shall be borne by you."]}),n.jsx("p",{children:"You cannot transfer your account to any other person, and a third party may not access your account without our permission. We may terminate, suspend or cancel your account if we are made aware of any such authorized access or use."}),n.jsxs("p",{children:["Please let us know as soon as possible if you believe that someone else is using your Account (or if you suspect any other breach of security) by contacting our support team at"," ",n.jsx("a",{href:"mailto:hello@sheryians.com",className:"underline cursor-pointer font-extrabold text-underline hover:text-[#E8602E] transition-colors duration-300",children:"hello@sheryians.com"})]}),n.jsxs("p",{children:["You can at any time decide to terminate your account by contacting us at"," ",n.jsx("a",{href:"mailto:hello@sheryians.com",className:"underline cursor-pointer font-extrabold text-underline hover:text-[#E8602E] transition-colors duration-300",children:"hello@sheryians.com"}),"."]})]})},{id:2,title:"USER CONDUCT AND BEHAVIOR",content:n.jsxs("div",{className:"space-y-4  text-gray-700 leading-relaxed",children:[n.jsx("p",{children:"You agree to participate in any Services with sincerity, diligence and not indulgence in any unethical, corrupt or illegal practice. This includes behavior that amounts to cheating, collusion or any coordination action conducted with the intention to subvert these Terms or any conditions that may be applicable."}),n.jsx("p",{children:'You agree not to post, transmit or cause to be posted or transmitted post that amounts to solicitation of a service or a business, or provided with the intent or activities commonly referred to as "phishing", "pharming" or "whaling", or any message or post intended to obtain personal information, including passwords, financial information, card details or confidential information of a person.'}),n.jsx("p",{children:"You shall also not indulge in activities that amount to:"}),n.jsxs("ul",{className:"list-disc md:ml-10 space-y-2",children:[n.jsx("li",{children:"Harassment of other users, instructors, Sheryians Private Limited personnel, or other third parties"}),n.jsx("li",{children:"Disparage, defame, or bring disrepute to any person, or show hostility toward, bully, or create disharmony among other users or third parties."})]}),n.jsx("p",{children:"We have the right to report any such suspicious activity to legal or law enforcement authorities without notice from time to time."}),n.jsx("p",{children:"You agree to provide true and correct information to us at the time of enrollment, and not use any tool, service, platform or technique to change your location or provide incorrect details with an aim to impact any restrictions, limitations, or technical features to the Services."}),n.jsx("p",{children:"You may not do any of the following while accessing or using the Platform and Services:"}),n.jsxs("ul",{className:"list-disc md:ml-10 space-y-2",children:[n.jsx("li",{children:"Access, tamper with, or use non-public areas of the Platform, the Company's computer systems, or the technical delivery systems of the Company's service providers."}),n.jsx("li",{children:"Disable, interfere with, or attempt to circumvent any security-related features of the Platform, or probe, scan, or test the vulnerability of any of our systems."}),n.jsx("li",{children:"copy, modify, create derivative works of, reverse engineer, reverse assemble, or otherwise attempt to discover the source code, underlying structure, or content of the Platform or Services."}),n.jsx("li",{children:"access or search or attempt to access or search our Platform by any means (automated or otherwise) other than through our currently available search functionalities that are provided via our platform. You may not scrape, spider, use a robot, or use other automated means of any kind to access the Services"}),n.jsx("li",{children:"in any way use the Services to send altered, deceptive, or false source-identifying information; or interfere with, or disrupt, (or attempt to do so), the access of any user, host, or network, including, without limitation, sending a virus, overloading, flooding, spamming, or mail-bombing the platforms or services, or in any other manner interfering with or creating an undue burden on the Services."}),n.jsx("li",{children:"Downloading or any other means of illegally acquiring the content"})]})]})},{id:3,title:"COURSE AND CONTENT",content:n.jsxs("div",{className:"space-y-4  text-gray-700 leading-relaxed",children:[n.jsx("p",{children:"By creating an Account you shall receive access to videos, text, or other material (Content), training programs (Courses), advice and support (Instructors) and services such as training platforms and technologies, on our Platform. These Services may be made available for free or on the payment of charges that may be displayed on the Platform"}),n.jsx("p",{children:"You will have the license to view our course via our Platform for the duration of the course and subsequently, as may be notified to you. The Services, especially any Courses or Content are for your personal use and benefit alone, and not meant for commercial use."}),n.jsx("p",{children:"You are granted a limited, non-exclusive, non-transferable license to access and view the Courses and associated Content solely for your personal, non- commercial, educational purposes through the Services"}),n.jsx("p",{children:"All other uses are expressly prohibited. This does not give you any right to resell the course in any manner, or display, distribute, or make available any Course or Content on the Platform to any third party any manner, for a fee or otherwise."}),n.jsx("p",{children:"This includes but is not limited to, sharing account information with third parties, downloading the course, sharing or uploading the course on any platform. We reserve the right to revoke any license to access and use any Services at any point in time if we decide or are obligated to disable access to a course due to legal or policy reasons."}),n.jsx("p",{children:"Some of the additional features/ Services on the Platform or a Course may be disabled by us from time to time. For example, we may disable, suspend or terminate access to translations, Q&A services, teaching assistance, if such services are no longer available, on the lack of availability of instructors, or other considerations it may be notified on the Platform or to you specifically"}),n.jsx("p",{children:"We also retain the right to cancel, reschedule, modify, alter or rearrange any Course, or any Content, including any lectures by instructors, representation of topics in Courses, scoring of tests, quizzes, manner of evaluation."})]})},{id:4,title:"PAYMENT, CREDITS, AND REFUNDS",content:n.jsxs("div",{className:"space-y-4  text-gray-700 leading-relaxed",children:[n.jsx("ul",{className:"list-disc ",children:n.jsx("li",{children:n.jsx("p",{className:"font-extrabold text-underline ",children:"Pricing"})})}),n.jsx("p",{className:"md:ml-5",children:"The prices of the Courses and other Services are informed to you on the Platform, and may vary from time to time. Pricing may also be determined based on other considerations such as (but not limited to)"}),n.jsxs("ul",{className:"list-[lower-roman] ml-5 md:ml-10 space-y-2",children:[n.jsx("li",{children:"applicable promotions or discount vouchers;"}),n.jsx("li",{children:"a user's credits on the platform;"}),n.jsx("li",{children:"Their location at the time of using the Platform, or the country of residence declared at the time of creating an Account."}),n.jsx("li",{children:"currency of payment applicable taxes, processing fees, bank transfer charges, or currency conversion."})]}),n.jsx("p",{children:"We may also agree to provide bulk rates for institutional purchases, which may be accessible based on your email id, specific links or other forms of access as developed by us."}),n.jsx("p",{children:"The price applicable to a course will be the price at the time you complete your purchase of the course (at checkout)."}),n.jsx("ul",{className:"list-disc",children:n.jsx("li",{children:n.jsx("p",{className:"font-extrabold text-underline ",children:"Payments"})})}),n.jsxs("ul",{className:"list-[lower-roman] ml-5 md:ml-10 space-y-2",children:[n.jsx("li",{children:"You agree to pay the fees for the Services that you purchase. To achieve this, you agree to share with us/ our authorized payments partners with your personal and financial information that may be necessary, and authorize us to charge your debit or credit card or process other means of payment (such as direct debit, or mobile wallet) for such fees."}),n.jsx("li",{children:"You agree that you are authorized to use the payment instrument or payment method by which you make any payment to us, and that such payment method has been duly and validly issued."}),n.jsx("li",{children:"We may continue to provide you access to a Course or any other Services, even if your payment to us fails, subject to you making the payment within the time period prescribed by us."}),n.jsx("li",{children:"We reserve the right to disable access to any Service for which we have not received adequate payments."})]}),n.jsxs("ul",{className:"list-disc",children:[n.jsx("li",{children:n.jsx("p",{className:"font-extrabold text-underline ",children:"Refunds"})}),n.jsx("p",{className:"md:ml-5",children:"We are happy to provide you with a refund of 100% for a Course,within 3 days of the start of a batch."}),n.jsx("p",{className:"md:ml-5",children:"If you want to claim a refund, please do so by:"})]}),n.jsxs("ul",{className:"list-[lower-roman] ml-10 md:ml-10 space-y-2",children:[n.jsxs("li",{children:["Drop an email on:"," ",n.jsxs("a",{href:"mailto:hello@sheryians.com",className:"underline cursor-pointer font-extrabold text-underline hover:text-[#E8602E] transition-colors duration-300",children:["hello@sheryians.com"," "]}),"with a subject “ONLINE COURSE REFUND | REGISTERED EMAIL ID” Please do not forget to provide the registered email ID in the subject"]}),n.jsx("li",{children:" Give your reason for the refund, for our internal purposes"}),n.jsx("li",{children:"Please ensure that the email is received within three days of the batch start date"}),n.jsx("p",{className:"ml-5 italic",children:"For example: If a batch starts on 15 July 2023, you should send the refund email on or before 12:00 am, 18 July 2023."}),n.jsxs("li",{children:["Calculation of refunds (ONLY FOR RECORDED COURSES)",n.jsxs("ul",{className:"list-[lower-alpha] ml-5",children:[n.jsx("li",{children:"100%: if you consumed only the first 2 lectures of the course"}),n.jsx("li",{children:"Prorated: In case you have consumed more than the first 2 lectures of the course For example: if you have watched 10 lectures out of a total of 100 lectures in the course then 90% of the fees will be refunded"})]})]}),n.jsx("li",{children:"Refunds will be processed within 10 to 20 working days of receiving the refund email with the necessary details (and subject line). This refund process is applicable only on recorded courses"}),n.jsx("li",{children:"For Live Batches / Courses we do a full refund within 7 days from the start of the course. After that no refund will be initiated. Please ensure that the email is received within five days of the batch start date. For example: If a batch starts on 15 July 2023, you should send the refund email on or before 12:00 am, 20 July 2023."})]})]})},{id:5,title:"SHERYIANS PRIVATE LIMITED RIGHTS TO CONTENT YOU POST",content:n.jsxs("div",{className:"space-y-4  text-gray-700 leading-relaxed",children:[n.jsx("p",{children:"You retain ownership of content you post to our Platform, including your feedback, messages, notes, text, documents, presentations, and other content that you upload, publish or display."}),n.jsx("p",{children:"We're allowed to share your content to anyone through any media, including promoting it via advertising on other websites. You agree that you own the rights to any content shared on the Platform."}),n.jsx("p",{children:"We may, at our discretion, delete or remove (without notice) any user content in its sole discretion, for any reason or no reason, including without limitation user content that in the sole judgment of the Company violates these Terms."}),n.jsx("p",{children:"You also hereby grant each user of the Platform (subject to such limitations, if any, that may apply with respect to Private Content) a non-exclusive license to access your content through the Platform, and to use, reproduce, distribute, prepare derivative works of, and display such content as permitted through the functionality of the Platform and under these Terms."})]})},{id:6,title:"USING PLATFORM AT YOUR OWN RISK",content:n.jsxs("div",{className:"space-y-4  text-gray-700 leading-relaxed",children:[n.jsx("p",{children:"We do not provide any warranty or guarantee relating to any of our Services, and they are provided on an 'as-is' basis. You agree to use the Platform and avail any Service at your own risk."}),n.jsx("p",{children:"We request you to be careful and prudent in your interactions with Instructors, or support officers. Please do not share any information, including personal details such as where you live, your financial information or other details. We are not liable for disputes, claims, losses, injuries, or damage of any kind that might arise out of or relate to the conduct of instructors or students."}),n.jsx("p",{children:"When you use our Services, you will find links to other websites that we don't own or control, such as payment service providers, advertisers, recruitment platforms. We are not responsible for availability, reliability, accuracy of any third party services."}),n.jsx("p",{children:"We strongly recommend that you read the applicable terms and conditions for their use prior to accessing them."})]})},{id:7,title:"OUR ROLE",content:n.jsxs("div",{className:"space-y-4  text-gray-700 leading-relaxed",children:[n.jsx("p",{children:"We are not a University, Institute or any form of a registered or accredited institution. We provide access to online training software and content."}),n.jsx("p",{children:"We do not recommend use of the Sheryians Private Limited platform in substitution of an educational institution such as a school, college or university. We may provide you with rewards, credentials or acknowledgements based on your completion of a Course, or performance while availing a Service."}),n.jsx("p",{children:"Any such recognition is given by Sheryians Private Limited at its discretion. Such recognitions are provided by an educational institution and nor are they equivalent to an award, degree, certificate or other recognitions provided by an educational institution."}),n.jsx("p",{children:"We do not provide any guarantee admission in any educational institution or procurement of a job, or any other remunerative opportunity by accessing the Platform and availing the Services. We partner with educational institutes from time to time, to provide you access to educational programs, and Courses."}),n.jsx("p",{children:"These educational institutes may provide you with, through our platform, degrees, certificates upon fulfilling the criteria notified in the Courses. Enrolment in a Course or a Service provided in partnership with such educational partner does not grant you the right to any other association with such education partner (other than as specifically provided on the Platform)."})]})},{id:8,title:"TERMINATION, SUSPENSION",content:n.jsxs("div",{className:"space-y-2  text-gray-700 leading-relaxed",children:[n.jsx("p",{children:"We may terminate your membership, delete your Account and any content or information that you have posted on the Site and/or prohibit you from using or accessing the Service or the Site (or any portion, aspect or feature of the Service or the Site) at our discretion, including if we identify any potential violation of these Terms."}),n.jsx("p",{children:"All terminations shall be made in our sole discretion and that we shall not be liable to you nor any third-party for any termination of your Account or access to our Service."})]})},{id:9,title:"MISCELLANEOUS TERMS",content:n.jsxs("div",{className:"space-y-2  text-gray-700 leading-relaxed",children:[n.jsx("p",{children:"Sheryians Private Limited Communications You agree to receive communications from the Company in connection with your use of Services in the form of email or SMS messages, including without limitation account activity notification, service updates, and reminders."}),n.jsxs("ul",{className:"list-disc md:ml-10 space-y-2",children:[n.jsxs("li",{children:[n.jsx("p",{className:"text-xl font-bold",children:"Member Disputes"}),n.jsx("p",{children:"You are solely responsible for your interactions with other Members. Sheryians Private Limited reserves the right, but has no obligation to monitor disputes between you and other Members."})]}),n.jsxs("li",{children:[n.jsx("p",{className:"text-xl font-bold",children:"Privacy"}),n.jsx("p",{children:"Use of the Services is also governed by our Privacy Policy, which is incorporated into this Agreement by this reference. By accepting this Agreement, you agree to indemnify and otherwise hold harmless the Company, its officers, employees, agents, subsidiaries, affiliates and other partners from any direct, indirect, incidental, special, consequential or exemplary damages resulting from your use of the Service, unauthorized access to or alteration of your communications with or through the Service, or any other matter relating to the Service."})]}),n.jsx("p",{className:"mt-5",children:"Any business transactions which may arise between users from their use of the Platform are the sole responsibility of the users involved. Without limitation of the terms set forth in our Privacy Policy, you understand and agree that the Company may disclose personally identifiable information if required to do so by law or in the good faith belief that such disclosure is reasonably necessary to comply with legal process, enforce this Agreement, or protect the rights, property, or safety of the Company, its users, and the public."}),n.jsx("li",{children:n.jsxs("p",{children:[" ",n.jsx("span",{className:"text-xl font-bold",children:"Disclaimer of Warranties"})," ","YOU UNDERSTAND AND AGREE THAT THE SERVICE IS PROVIDED ON AN (AS IS) AND (AS AVAILABLE) BASIS AND THAT THE COMPANY DOES NOT ASSUME ANY RESPONSIBILITY FOR PROMPT OR PROPER DELIVERY, OR RETENTION OF ANY USER INFORMATION OR COMMUNICATIONS BETWEEN USERS. THE COMPANY ASSUMES NO RESPONSIBILITY FOR THE ACCURACY OR EXISTENCE OF ANY COMMUNICATIONS BETWEEN USERS. THE COMPANY EXPRESSLY DISCLAIMS ALL WARRANTIES OF ANY KIND, WHETHER EXPRESSED OR IMPLIED, INCLUDING, BUT NOT LIMITED TO THE IMPLIED WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. THE COMPANY MAKES NO WARRANTY THAT THE SERVICE WILL MEET YOUR REQUIREMENTS; THAT THE SERVICE WILL BE UNINTERRUPTED, TIMELY, SECURE, OR ERROR-FREE; AND THAT THE RESULTS THAT MAY BE OBTAINED FROM USE OF THE SERVICE WILL BE ACCURATE OR RELIABLE. THE QUALITY OF ANY PRODUCTS, SERVICES, INFORMATION, OR OTHER MATERIAL PURCHASED OR OBTAINED BY YOU THROUGH THE SERVICE WILL MEET YOUR EXPECTATIONS, OR ANY ERRORS IN THE SOFTWARE WILL BE CORRECTED. ANY MATERIAL DOWNLOADED OR OTHERWISE OBTAINED THROUGH THE USE OF THE SERVICE IS DONE AT YOUR OWN DISCRETION AND RISK AND THAT YOU WILL BE SOLELY RESPONSIBLE FOR ANY DAMAGE TO YOUR COMPUTER SYSTEM OR LOSS OF DATA THAT RESULTS FROM THE DOWNLOAD OF ANY SUCH MATERIAL. NO ADVICE OR INFORMATION, WHETHER ORAL OR WRITTEN, OBTAINED BY YOU FROM THE COMPANY OR THROUGH OR FROM THE SERVICE SHALL CREATE ANY WARRANTY NOT EXPRESSLY STATED IN THIS AGREEMENT. SOME JURISDICTIONS DO NOT ALLOW THE EXCLUSION OF CERTAIN WARRANTIES OR THE LIMITATION OR EXCLUSION OF LIABILITY FOR INCIDENTAL OR CONSEQUENTIAL DAMAGES. ACCORDINGLY, SOME OF THE ABOVE LIMITATIONS MAY NOT APPLY TO YOU."]})}),n.jsxs("li",{className:"my-5",children:[n.jsx("p",{className:"text-xl font-bold",children:"Limitation of Liability"}),n.jsx("p",{className:"mt-5",children:"YOU EXPRESSLY UNDERSTAND AND AGREE THAT THE COMPANY SHALL NOT BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, CONSEQUENTIAL OR EXEMPLARY DAMAGES, INCLUDING BUT NOT LIMITED TO DAMAGES FOR LOSS OF PROFITS, GOODWILL, USE, DATA OR OTHER INTANGIBLE LOSSES (EVEN IF THE COMPANY HAS BEEN ADVISED OF THE POSSIBILITY OF SUCH DAMAGES). SOME JURISDICTIONS DO NOT ALLOW THE EXCLUSION OF THE LIMITATION OR EXCLUSION OF LIABILITY FOR INCIDENTAL OR CONSEQUENTIAL DAMAGES. ACCORDINGLY, SOME OF THE ABOVE LIMITATIONS MAY NOT APPLY TO YOU. IN NO EVENT WILL Sheryians Private Limited's TOTAL CUMULATIVE DAMAGES EXCEED INR 1000."})]}),n.jsxs("li",{children:[n.jsx("p",{className:"text-xl font-bold",children:"Governing Law and Dispute Resolution"}),n.jsx("p",{className:"mt-5",children:"The Agreement between you and Company will be governed by, and construed in accordance with the laws of India without regard to conflict of laws principles. Subject to specific agreements relating to dispute resolution, disputes shall be subject to the laws of India and the courts of New Delhi shall have exclusive jurisdiction over all such disputes."})]}),n.jsxs("li",{children:[n.jsx("p",{className:"text-xl font-bold",children:"Mechanism for Complaints"}),n.jsxs("p",{className:"mt-5",children:["In case any transaction or attempted transaction in violation of these Terms and/or any applicable law, rules, regulations, etc. come to your knowledge, or if you have any queries or concerns regarding the Terms, please feel free to reach out to our Support Team at"," ",n.jsx("a",{href:"mailto:hello@sheryians.com",className:"underline cursor-pointer font-extrabold text-underline hover:text-[#E8602E] transition-colors duration-300",children:"hello@sheryians.com"})]})]}),n.jsxs("li",{children:[n.jsx("p",{className:"text-xl font-bold",children:"Assignment"}),n.jsx("p",{className:"mt-5",children:"These Terms, and any rights and licenses granted hereunder, may not be transferred or assigned by you, but may be assigned by the Company without restriction."})]})]})]})}],r3=[{id:1,title:"Pricing Policy",content:n.jsxs("div",{className:"space-y-5 text-gray-700 leading-relaxed",children:[n.jsxs("div",{children:[n.jsx("h3",{className:"font-bold",children:"Price Range"}),n.jsx("p",{children:"At SHERYIANS PRIVATE LIMITED, We have customized pricing according to the services rendered by us. The details are provided to you beforehand according to the effort, efficiency and the output of the service.Typically, the range of transactions on our website varies from INR 1.00/- to 20,000.00/-."})]}),n.jsxs("div",{children:[n.jsx("h3",{className:"font-bold",children:"Schedule of payment"}),n.jsx("p",{children:"Some of our services can be utilized for fixed durations. In such cases, it is clearly mentioned within the description of these services. The period of usage in these cases vary from 15 days to 1 year."})]}),n.jsxs("div",{children:[n.jsx("h3",{className:"font-bold",children:"Price Matching"}),n.jsx("p",{children:"At SHERYIANS PRIVATE LIMITED, we are committed to offering you the best possible prices."})]}),n.jsxs("div",{children:[n.jsx("h3",{className:"font-bold",children:"Pricing Errors"}),n.jsx("p",{children:"We work hard to ensure the accuracy of pricing. Despite our efforts, pricing errors may still occur. If a course